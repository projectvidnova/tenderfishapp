{
  "name": "tenderfish",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:start": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "turbo db:generate --filter=@tenderfish/db",
    "db:migrate": "turbo db:migrate --filter=@tenderfish/db",
    "db:push": "turbo db:push --filter=@tenderfish/db",
    "db:studio": "turbo db:studio --filter=@tenderfish/db"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.0"
}
