# Tenderfish — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://tenderfish:localdev@localhost:5433/tenderfish

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=generate-a-random-string-at-least-32-chars

# Social Login (optional — enable providers you need)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Provider: "ionos" (default) or "anthropic"
AI_PROVIDER=ionos

# IONOS AI (required when AI_PROVIDER=ionos)
IONOS_API_KEY=
IONOS_AI_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_AI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Anthropic AI (required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Postmark Email
POSTMARK_API_KEY=
POSTMARK_INBOUND_HASH=

# S3-compatible Object Storage (IONOS)
S3_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
S3_REGION=de
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tenderfish-dev-files

# App
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15 minutes

# File Upload
MAX_FILE_SIZE_BYTES=52428800

# CORS
CORS_MAX_AGE_SECONDS=86400

# Signed URLs
SIGNED_URL_EXPIRY_MS=900000

# AI Token Limits
AI_MAX_TOKENS_EXTRACT=4096
AI_MAX_TOKENS_CLASSIFY=2048
AI_MAX_TOKENS_CHAT=1024
AI_FACT_EXTRACTION_MAX_CHARS=100000
AI_CLASSIFICATION_MAX_CHARS=50000

# Chat
CHAT_HISTORY_LIMIT=10

# Defaults
DEFAULT_COUNTRY=Germany
