# Tenderfish — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://tenderfish:localdev@localhost:5433/tenderfish

# Redis
REDIS_URL=redis://localhost:6379

# Clerk Auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Anthropic AI
ANTHROPIC_API_KEY=

# Postmark Email
POSTMARK_API_KEY=
POSTMARK_INBOUND_HASH=

# S3-compatible Object Storage (IONOS)
S3_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
S3_REGION=de
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tenderfish-dev-files

# App
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15 minutes

# File Upload
MAX_FILE_SIZE_BYTES=52428800

# CORS
CORS_MAX_AGE_SECONDS=86400

# Signed URLs
SIGNED_URL_EXPIRY_MS=900000

# AI Configuration
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS_EXTRACT=4096
AI_MAX_TOKENS_CLASSIFY=2048
AI_MAX_TOKENS_CHAT=1024
AI_FACT_EXTRACTION_MAX_CHARS=100000
AI_CLASSIFICATION_MAX_CHARS=50000

# Chat
CHAT_HISTORY_LIMIT=10

# Defaults
DEFAULT_COUNTRY=Germany
